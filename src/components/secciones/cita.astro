---
// Pedir cita: banda turquesa partida 50/50. A la izquierda, titular, pasos en píldoras numeradas (`items`), el
// formulario con especie (`opciones`: «Perro; Gato; …») y los atajos de WhatsApp (`cta.texto`; destino `cta.url`
// o, si está vacío, el WhatsApp de contacto) y teléfono. A la derecha, la foto (`imagen`) a sangre hasta el borde
// derecho de la ventana, recortada en medio óvalo. Sin foto, el formulario ocupa todo el ancho.
import { seccion, site, tel, whatsapp } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioCita from '../ui/FormularioCita.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const pasos = s ? s.items.filter((it) => it?.titulo) : [];
const destinoWa = s?.cta?.url || whatsapp(c.whatsapp, 'Hola, quiero pedir cita');
const textoWa = s?.cta?.texto || '';
---

{
  s && (
    <Seccion id={Astro.props.id} tono="turquesa" contenedor={false}>
      <div class:list={['cita-fila', { 'cita-fila--sin-foto': !s.imagen }]}>
        <div class="cita-cuerpo">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {pasos.length > 0 && (
            <ol class="mt-7 flex flex-wrap gap-2">
              {pasos.map((p, i) => (
                <li class="pastilla bg-white/12 ring-1 ring-white/25">
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-acento text-sm font-extrabold text-[var(--tinta)]">{i + 1}</span>
                  {p.titulo}
                </li>
              ))}
            </ol>
          )}
          <div class="cita-panel">
            <FormularioCita opciones={String(s.opciones ?? '')} />
          </div>
          {(destinoWa && textoWa || c.telefono) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {destinoWa && textoWa && (
                <a href={destinoWa} rel="noopener" target="_blank" class="btn-sec">
                  <Icono nombre="whatsapp" tam={20} /> {textoWa}
                </a>
              )}
              {c.telefono && (
                <a href={tel(c.telefono)} class="btn-sec">
                  <Icono nombre="telefono" tam={18} /> {c.telefono}
                </a>
              )}
            </div>
          )}
        </div>
        {s.imagen && (
          <div class="cita-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1500} class="h-full w-full object-cover" />
          </div>
        )}
      </div>
    </Seccion>
  )
}

<style>
  .cita-fila { display: grid; gap: 2.5rem; }
  .cita-cuerpo { padding-inline: 1rem; }
  .cita-panel { margin-top: 2rem; padding: clamp(1.25rem, 3vw, 2.25rem); border-radius: 2.25rem; background: color-mix(in srgb, var(--hondo) 55%, transparent); }
  .cita-panel :global(.campo label) { color: #fff; }
  .cita-panel :global(.formulario-aviso), .cita-panel :global(.campo-check) { color: #fff; }
  .cita-foto { order: -1; overflow: hidden; margin-top: calc(-1 * var(--pad)); aspect-ratio: 4 / 3; border-radius: 0 0 50% 50% / 0 0 20% 20%; }
  @media (min-width: 640px) and (max-width: 899px) { .cita-foto { aspect-ratio: 16 / 9; } }
  @media (min-width: 768px) { .cita-cuerpo { padding-inline: 2rem; } }
  @media (min-width: 900px) {
    .cita-fila { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(2.5rem, 5vw, 5rem); }
    .cita-cuerpo { padding-left: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); padding-right: 0; }
    .cita-foto { order: 0; align-self: stretch; margin-top: calc(-1 * var(--pad)); margin-bottom: calc(-1 * (var(--pad) + var(--r))); aspect-ratio: auto; min-height: 40rem; border-radius: 50% 0 0 50% / 30% 0 0 30%; }
    .cita-fila--sin-foto { grid-template-columns: minmax(0, 1fr); }
    .cita-fila--sin-foto .cita-cuerpo { max-width: calc(var(--ancho)); padding-right: 2rem; }
  }
</style>
