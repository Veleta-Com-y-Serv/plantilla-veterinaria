---
// Consejos (blog sencillo): banda blanca con artículos `noticias` {fecha, titulo, texto, imagen, url}. Cada foto
// se recorta en arco (semicírculo arriba); la fecha va en una chapa coral. Con `url`, la ficha entera es un
// enlace. 1 columna en móvil, 2 en tableta, 3 en escritorio. Sin artículos, solo el titular.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const noticias = s ? s.noticias.filter((n) => n?.titulo) : [];
---

{
  s && (
    <Seccion id={Astro.props.id} tono="claro">
      <Titular alinear="partido" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {noticias.length > 0 && (
        <ul class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
          {noticias.map((n) => {
            const Etiqueta = n.url ? 'a' : 'div';
            return (
              <li>
                <Etiqueta href={n.url || undefined} class:list={['consejo block', { 'consejo--enlace': n.url }]}>
                  {n.imagen && (
                    <div class="consejo-arco">
                      <Imagen src={n.imagen} alt={n.titulo} ancho={900} alto={720} class="h-full w-full object-cover" />
                    </div>
                  )}
                  {n.fecha && <p class="consejo-fecha">{n.fecha}</p>}
                  <h3 class="mt-3 text-[1.45rem] md:text-[1.6rem]">{n.titulo}</h3>
                  {n.texto && <p class="mt-2 opacity-80">{n.texto}</p>}
                  {n.url && (
                    <span class="mt-4 inline-flex items-center gap-2 font-bold text-primario">
                      Leer <Icono nombre="flecha" tam={18} />
                    </span>
                  )}
                </Etiqueta>
              </li>
            );
          })}
        </ul>
      )}
      {s.cta?.url && <a class="btn btn--turquesa mt-12" href={s.cta.url}>{s.cta.texto}</a>}
    </Seccion>
  )
}

<style>
  .consejo { text-decoration: none; }
  .consejo-arco { overflow: hidden; aspect-ratio: 5 / 4; border-radius: 999px 999px 2rem 2rem; background: var(--menta); }
  .consejo-arco :global(img) { transition: transform .4s ease; }
  .consejo--enlace:hover .consejo-arco :global(img) { transform: scale(1.05); }
  .consejo--enlace:hover h3 { color: var(--c-primario); }
  .consejo-fecha { display: inline-flex; margin-top: 1.25rem; padding: .3rem .85rem; border-radius: 999px; background: var(--coral-suave); color: var(--tinta); font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .consejo-arco + .consejo-fecha { margin-top: -1.1rem; margin-left: 1.25rem; position: relative; background: var(--c-acento); }
</style>
