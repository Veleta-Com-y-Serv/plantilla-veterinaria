---
// Apartado de texto genérico: banda menta con antetítulo, título, párrafos, lista con icono y botón. Con imagen,
// banda partida 50/50 con la foto a sangre hasta el borde derecho, recortada en medio óvalo.
// Lo usan los apartados nuevos que pide el cliente (site.yaml: `tipo: texto`).
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it?.titulo) : [];
---

{
  s && (
    <Seccion id={Astro.props.id} tono="menta" contenedor={false}>
      <div class:list={['texto-fila', { 'texto-fila--sin-foto': !s.imagen }]}>
        <div class="texto-cuerpo">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} class="!mb-0" />
          <div class:list={['mt-6 grid gap-x-12 gap-y-4 text-[1.08rem] opacity-85', { 'lg:grid-cols-2': !s.imagen }]}>
            {parrafos(s.texto).map((p) => <p>{p}</p>)}
          </div>
          {items.length > 0 && (
            <ul class:list={['mt-8 grid gap-4', { 'md:grid-cols-2 lg:grid-cols-3': !s.imagen }]}>
              {items.map((it) => (
                <li class="flex gap-4">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-primario text-white">
                    <Icono nombre={it.icono} tam={20} />
                  </span>
                  <div>
                    <p class="font-bold">{it.titulo}</p>
                    {it.texto && <p class="text-sm opacity-75">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <a class="btn btn--turquesa mt-9" href={s.cta.url}>{s.cta.texto}</a>}
        </div>
        {s.imagen && (
          <div class="texto-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1000} class="h-full w-full object-cover" />
          </div>
        )}
      </div>
    </Seccion>
  )
}

<style>
  .texto-fila { display: grid; gap: 2.5rem; }
  .texto-cuerpo { padding-inline: 1rem; }
  .texto-foto { order: -1; overflow: hidden; margin-top: calc(-1 * var(--pad)); aspect-ratio: 4 / 3; border-radius: 0 0 50% 50% / 0 0 20% 20%; }
  @media (min-width: 768px) {
    .texto-cuerpo { width: 100%; max-width: var(--ancho); margin-inline: auto; padding-inline: 2rem; }
  }
  @media (min-width: 640px) and (max-width: 899px) { .texto-foto { aspect-ratio: 16 / 9; } }
  @media (min-width: 900px) {
    .texto-fila:not(.texto-fila--sin-foto) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2.5rem, 6vw, 6rem); }
    .texto-fila:not(.texto-fila--sin-foto) .texto-cuerpo { max-width: none; padding-left: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); padding-right: 0; }
    .texto-foto { order: 0; align-self: stretch; aspect-ratio: auto; min-height: 30rem; height: calc(100% + var(--pad)); border-radius: 50% 0 0 50% / 32% 0 0 32%; }
  }
</style>
