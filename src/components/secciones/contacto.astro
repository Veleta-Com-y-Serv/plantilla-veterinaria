---
// Contacto: banda blanca partida. A la izquierda la foto (`imagen`: la fachada o el barrio) a sangre hasta el
// borde de la ventana, con una gran esquina redondeada y una chapa coral «Cómo llegar» que abre el mapa. A la
// derecha, titular, datos con icono, `horario` {dia, horas} en filas y, si la sección `cita` no está activa,
// el formulario de contacto.
import { seccion, site, tel, mapa, whatsapp } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const horario = s ? s.horario.filter((h) => h?.dia || h?.horas) : [];
const conFormulario = !seccion('cita');
const datos = [
  c.direccion && { icono: 'mapa', texto: c.direccion, url: mapa(c.direccion), externo: true },
  c.telefono && { icono: 'telefono', texto: c.telefono, url: tel(c.telefono), externo: false },
  c.whatsapp && { icono: 'whatsapp', texto: c.whatsapp, url: whatsapp(c.whatsapp), externo: true },
  c.email && { icono: 'correo', texto: c.email, url: `mailto:${c.email}`, externo: false },
].filter(Boolean) as { icono: string; texto: string; url: string; externo: boolean }[];
---

{
  s && (
    <Seccion id={Astro.props.id} tono="claro" contenedor={false}>
      <div class:list={['contacto-fila', { 'contacto-fila--sin-foto': !s.imagen }]}>
        {s.imagen && (
          <div class="contacto-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1100} class="h-full w-full object-cover" />
            {c.direccion && (
              <a href={mapa(c.direccion)} rel="noopener" target="_blank" class="contacto-pin">
                <Icono nombre="mapa" tam={26} />
                <span>Cómo llegar</span>
              </a>
            )}
          </div>
        )}
        <div class="contacto-cuerpo">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {datos.length > 0 && (
            <ul class="mt-8 grid gap-3">
              {datos.map((x) => (
                <li>
                  <a href={x.url} rel={x.externo ? 'noopener' : undefined} target={x.externo ? '_blank' : undefined} class="contacto-dato">
                    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[var(--menta)] text-primario">
                      <Icono nombre={x.icono} tam={20} />
                    </span>
                    <span class="min-w-0 break-words">{x.texto}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {horario.length > 0 ? (
            <dl class="contacto-horario">
              {horario.map((h) => (
                <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-3">
                  <dt class="font-bold">{h.dia}</dt>
                  <dd class="opacity-80">{h.horas}</dd>
                </div>
              ))}
            </dl>
          ) : (
            c.horario && (
              <p class="mt-6 flex gap-3 opacity-85">
                <Icono nombre="reloj" class="mt-1 shrink-0 text-primario" tam={20} />
                {c.horario}
              </p>
            )
          )}
          {conFormulario && (
            <div class="mt-10 rounded-[2rem] bg-[var(--menta)] p-5 md:p-8">
              <FormularioContacto boton="Enviar mensaje" />
            </div>
          )}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .contacto-fila { display: grid; gap: 2.5rem; }
  .contacto-cuerpo { padding-inline: 1rem; max-width: 44rem; }
  .contacto-foto { position: relative; overflow: hidden; margin-top: calc(-1 * var(--pad)); aspect-ratio: 4 / 3; border-radius: 0 0 clamp(5rem, 22vw, 12rem) 0; }
  .contacto-pin { position: absolute; right: 1rem; bottom: 1rem; display: grid; place-content: center; justify-items: center; gap: .2rem; width: 7.5rem; height: 7.5rem; border-radius: 999px; background: var(--c-acento); color: var(--tinta); font-weight: 800; font-size: .9rem; text-decoration: none; transform: rotate(-8deg); box-shadow: 0 18px 40px -18px rgb(0 0 0 / .6); }
  .contacto-pin:hover { transform: rotate(-2deg) scale(1.04); }
  .contacto-dato { display: flex; align-items: center; gap: 1rem; min-height: 2.75rem; font-weight: 600; text-decoration: none; }
  .contacto-dato:hover { color: var(--c-primario); }
  .contacto-horario { margin-top: 2rem; padding: .5rem 1.5rem; border-radius: 1.75rem; border: 2px solid var(--menta); }
  .contacto-horario > div + div { border-top: 1px dashed color-mix(in srgb, var(--c-texto) 18%, transparent); }
  @media (min-width: 640px) and (max-width: 899px) { .contacto-foto { aspect-ratio: 16 / 9; } }
  @media (min-width: 768px) { .contacto-cuerpo { padding-inline: 2rem; } }
  @media (min-width: 900px) {
    .contacto-fila { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2.5rem, 6vw, 6rem); }
    .contacto-foto { align-self: stretch; margin-top: calc(-1 * var(--pad)); margin-bottom: calc(-1 * (var(--pad) + var(--r))); aspect-ratio: auto; min-height: 36rem; border-radius: 0 clamp(8rem, 16vw, 16rem) 0 0; }
    .contacto-pin { right: 2.5rem; bottom: calc(var(--r) + 2rem); width: 9rem; height: 9rem; font-size: 1rem; }
    .contacto-cuerpo { padding-inline: 0 2rem; }
    .contacto-fila--sin-foto { grid-template-columns: minmax(0, 1fr); }
    .contacto-fila--sin-foto .contacto-cuerpo { width: 100%; max-width: var(--ancho); margin-inline: auto; padding-inline: 2rem; }
  }
</style>
