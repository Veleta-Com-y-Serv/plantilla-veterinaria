---
// Formulario de cita sin servidor: abre el programa de correo (mailto) con el email de site.yaml.
// Pide la especie: desplegable con `opciones` («Perro; Gato; Conejo…», separadas por «;» o comas) o, si no
// hay opciones, un campo de texto. Si no hay email, se queda como muestra y lo avisa.
import { site } from '../../data/site';
interface Props { opciones?: string; boton?: string; class?: string }
const { opciones = '', boton = 'Pedir cita', class: clase = '' } = Astro.props;
const email = site.contacto.email;
const asunto = `Cita desde la web de ${site.nombre}`;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const especies = String(opciones ?? '')
  .split(/\s*[;,\n]\s*/)
  .map((x) => x.trim())
  .filter(Boolean);
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="campo">
      <label for="cita-nombre">Tu nombre</label>
      <input id="cita-nombre" name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for="cita-contacto">Teléfono o email</label>
      <input id="cita-contacto" name="contacto" type="text" autocomplete="tel" required />
    </div>
    <div class="campo">
      <label for="cita-animal">Nombre del animal</label>
      <input id="cita-animal" name="animal" type="text" />
    </div>
    <div class="campo">
      <label for="cita-especie">Especie</label>
      {
        especies.length > 0 ? (
          <select id="cita-especie" name="especie" required>
            <option value="">Elige una</option>
            {especies.map((e) => <option value={e}>{e}</option>)}
          </select>
        ) : (
          <input id="cita-especie" name="especie" type="text" required />
        )
      }
    </div>
  </div>
  <div class="campo">
    <label for="cita-motivo">¿Qué le pasa o qué necesita?</label>
    <textarea id="cita-motivo" name="motivo" rows="3" required></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con la petición lista.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
