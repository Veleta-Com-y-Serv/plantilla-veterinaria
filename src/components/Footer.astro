---
// Pie a todo el ancho en turquesa hondo, con las esquinas de arriba redondeadas como las bandas: marca y redes,
// contacto, menú y, si la sección `urgencias` está activa con teléfono, la chapa coral de urgencias.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie es true (plan gratis).
import { seccion, site, tel, mapa } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'chapa' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const urg = seccion('urgencias');
const d = (urg?.destacado ?? {}) as { titulo?: string; telefono?: string; texto?: string };
const telUrg = (d.telefono ?? '').toString().trim();
---

<footer class={`pie pie--${variante}`}>
  <div class:list={['contenedor pie-rejilla', { 'pie-rejilla--cuatro': telUrg }]}>
    <div class="pie-marca">
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div>
      <p class="pie-titulo">Contacto</p>
      <ul class="pie-lista">
        {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
        {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
        {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
        {c.horario && <li class="opacity-80">{c.horario}</li>}
      </ul>
    </div>
    {
      site.menu.length > 0 && (
        <div>
          <p class="pie-titulo">Web</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      telUrg && (
        <div>
          <a href={tel(telUrg)} class="pie-urgencias block no-underline">
            {d.titulo && <span class="block text-xs font-extrabold uppercase tracking-[.16em]">{d.titulo}</span>}
            <span class="mt-1 block font-display text-[1.9rem] leading-tight font-black tracking-tight">{telUrg}</span>
            {d.texto && <span class="mt-1 block text-sm">{d.texto}</span>}
          </a>
        </div>
      )
    }
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
