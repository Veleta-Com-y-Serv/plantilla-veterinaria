---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «chapa de collar»: banda turquesa con migas y hero partido (título con trazo coral, texto, precio, botones;
// a la derecha la foto en arco o, sin foto, su icono en un círculo grande); banda blanca con el `detalle` y, al lado,
// la tabla de datos y la caja coral de cita; fotos (`imagenes`) en banda menta; y otros servicios en banda hondo.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { partirTitulo, seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const [inicio, final] = partirTitulo(f.titulo);
const c = site.contacto;
const cita = seccion('cita') ? '/#cita' : site.boton_cabecera?.url || '/#contacto';
const textoCita = site.boton_cabecera?.texto || 'Pedir cita';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda tono-turquesa fv-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="fv-migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['fv-hero', { 'fv-hero--sin-foto': !f.imagen }]}>
        <div class="fv-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{inicio}<span class="resalte">{final}</span></h1>
          {f.texto && <p class="fv-lead">{f.texto}</p>}
          {f.precio && <p class="fv-precio-hero">{f.precio}</p>}
          <div class="fv-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="fv-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="fv-icono" aria-hidden="true"><Icono nombre={f.icono || 'huella'} tam={104} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda tono-claro">
    <div class="contenedor fv-cuerpo">
      <article class="texto-largo fv-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="fv-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="fv-datos">
            <h2 class="fv-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="fv-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="fv-cita tono-coral">
          <p class="fv-cita-titulo">¿Le damos cita a tu animal?</p>
          <p>Te explicamos qué vamos a hacer y cuánto cuesta antes de empezar.</p>
          <a class="btn btn--turquesa" href={cita}>{textoCita}</a>
          {c.telefono && <a class="fv-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda tono-menta" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="fv-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda tono-hondo">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="fv-otras">
          {otras.map((o) => (
            <li class="fv-otra">
              <span class="fv-otra-icono"><Icono nombre={o.icono || 'huella'} tam={26} /></span>
              <h3><a href={o.url} class="fv-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="fv-otra-pie">
                {o.precio && <span class="fv-precio">{o.precio}</span>}
                <span class="fv-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .fv-cabeza { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .fv-migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .fv-migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .fv-migas li + li::before { content: "›"; opacity: .6; }
  .fv-migas a { color: #fff; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; opacity: .85; }
  .fv-migas a:hover { text-decoration: underline; opacity: 1; }
  .fv-migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .fv-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .fv-hero-texto .titulo-seccion { font-size: clamp(2.3rem, 6vw, 4.5rem); overflow-wrap: anywhere; }
  .fv-lead { margin-top: 1.25rem; font-size: 1.15rem; opacity: .9; max-width: 38rem; }
  .fv-precio-hero { margin-top: 1.25rem; display: inline-block; padding: .35rem 1rem; border-radius: 999px; background: var(--c-acento); color: var(--tinta); font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.15rem; }
  .fv-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .fv-foto { aspect-ratio: 4 / 3; border-radius: 999px 999px var(--radio) var(--radio); overflow: hidden; background: var(--hondo); border: 6px solid var(--c-acento); }
  .fv-icono { display: grid; place-items: center; aspect-ratio: 1; max-width: 18rem; width: 100%; margin-inline: auto; border-radius: 999px; background: var(--c-fondo); color: var(--c-primario); border: 6px solid var(--c-acento); }
  .fv-cuerpo { display: grid; gap: 3rem; }
  .fv-detalle { max-width: 44rem; font-size: 1.12rem; }
  .fv-detalle p + p { margin-top: 1.2rem; }
  .fv-detalle p:first-child { font-size: 1.25rem; }
  .fv-lado { display: grid; gap: 1.5rem; align-content: start; }
  .fv-lado-titulo { font-size: 1.35rem; margin-bottom: 1rem; }
  .fv-datos { background: var(--menta); border-radius: 2rem; padding: 1.75rem 1.5rem; }
  .fv-datos dl { display: grid; }
  .fv-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid color-mix(in srgb, var(--c-primario) 25%, transparent); }
  .fv-datos dt { font-weight: 700; opacity: .7; }
  .fv-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .fv-precio { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.15rem; color: var(--c-primario); }
  .fv-cita { display: grid; gap: .9rem; border-radius: 2rem; padding: 1.75rem 1.5rem; }
  .fv-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.5rem; font-weight: 800; line-height: 1.15; }
  .fv-cita .btn { justify-self: start; }
  .fv-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: inherit; text-decoration: none; }
  .fv-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .fv-galeria li { aspect-ratio: 4 / 3; border-radius: 2rem; overflow: hidden; }
  .fv-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .fv-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; border-radius: 2rem; background: color-mix(in srgb, #fff 9%, transparent); transition: background-color .2s ease; }
  .fv-otra:hover { background: color-mix(in srgb, #fff 16%, transparent); }
  .fv-otra-icono { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px; background: var(--c-fondo); color: var(--c-primario); }
  .fv-otra h3 { font-size: 1.3rem; margin-top: .35rem; }
  .fv-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .fv-otra-enlace::after { content: ""; position: absolute; inset: 0; border-radius: 2rem; }
  .fv-otra-enlace:focus-visible { outline: none; }
  .fv-otra:has(.fv-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: 2px; }
  .fv-otra p { opacity: .85; }
  .fv-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .fv-otra .fv-precio { color: #fff; }
  .fv-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 750; color: var(--c-acento); }
  @media (min-width: 1024px) {
    .fv-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .fv-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .fv-lado { position: sticky; top: 6.5rem; }
  }
</style>
