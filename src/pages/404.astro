---
// Página no encontrada con el diseño de la plantilla: banda turquesa a todo el ancho y una chapa coral gigante.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base titulo="Página no encontrada">
  <section class="banda tono-turquesa error-banda">
    <span class="circulo error-c1" aria-hidden="true"></span>
    <div class="contenedor grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <p class="antetitulo">Error 404</p>
        <h1 class="mt-4 text-[clamp(2.6rem,7vw,5.75rem)]">Esta página se ha <span class="resalte">escapado.</span></h1>
        <p class="mt-5 max-w-xl text-lg opacity-90">Puede que el enlace esté mal o que la página se haya movido. Vuelve al inicio y te ayudamos desde allí.</p>
        <p class="mt-8 flex flex-wrap gap-3">
          <a class="btn" href="/">Volver al inicio</a>
          {site.contacto.telefono && <a class="btn-sec" href={`tel:${site.contacto.telefono.replace(/[^\d+]/g, '')}`}>{site.contacto.telefono}</a>}
        </p>
      </div>
      <p class="error-chapa" aria-hidden="true">404</p>
    </div>
  </section>
</Base>

<style>
  .error-banda { min-height: 70svh; display: flex; align-items: center; }
  .error-c1 { width: 40rem; height: 40rem; right: -12rem; top: -12rem; background: color-mix(in srgb, #fff 9%, transparent); }
  .error-chapa { display: grid; place-items: center; width: clamp(11rem, 26vw, 20rem); aspect-ratio: 1; border-radius: 999px; background: var(--c-acento); color: var(--tinta); font-family: var(--fuente-titulos); font-size: clamp(3.5rem, 8vw, 6.5rem); font-weight: 900; letter-spacing: -0.05em; transform: rotate(-9deg); box-shadow: 0 30px 60px -30px rgb(0 0 0 / .6); }
</style>
